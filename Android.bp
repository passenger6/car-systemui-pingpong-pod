package {
    default_applicable_licenses: ["CarSystemUI-PingPong_license"],
}

// The pod's own license, not the tree's: everything under this directory and its samples is
// Apache-2.0 by a third party, and Soong's license metadata says so.
license {
    name: "CarSystemUI-PingPong_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

android_library {
    name: "CarSystemUI-PingPong",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    static_libs: [
        "CarSystemUI-Shared",
    ],
    resource_dirs: [
        "res",
    ],
    plugins: ["dagger2-compiler"],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

// The pure parts of the game (physics, score, paddle drive, the Jev question and brain, the
// config ranges) under JUnit on a device or emulator: `atest CarSystemUI-PingPong-tests`.
// Self-instrumenting: no SystemUI process, no android.test.* classes, so no `libs`.
android_test {
    name: "CarSystemUI-PingPong-tests",

    manifest: "tests/AndroidManifest.xml",
    srcs: ["tests/src/**/*.kt"],
    static_libs: [
        "CarSystemUI-PingPong",
        "androidx.test.ext.junit",
        "androidx.test.runner",
        "junit",
        "truth",
    ],
    aaptflags: ["--extra-packages com.android.systemui.car.pingpong"],
    certificate: "platform",
    platform_apis: true,
    test_suites: ["device-tests"],
}
