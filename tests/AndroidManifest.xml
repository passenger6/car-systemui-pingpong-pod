    package="com.android.systemui.car.pingpong.tests">
    <application />
    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="com.android.systemui.car.pingpong.tests"
        android:label="CarSystemUI PingPong tests" />
</manifest>
