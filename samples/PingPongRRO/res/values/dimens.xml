<resources>
    <!-- The ball is a square task; the corner is half its side, so it is a circle. The same
         size at rest and in flight: the pod only moves the task, it never resizes it. -->
    <dimen name="pong_ball_size">284dp</dimen>
    <dimen name="pong_ball_corner">142dp</dimen>
    <!-- `celebrate`: the ball swollen on a win, still a circle. The only resize, done by the
         XML. -->
    <dimen name="pong_ball_big">350dp</dimen>
    <dimen name="pong_ball_big_corner">175dp</dimen>
    <dimen name="pong_paddle_width">24dp</dimen>
    <dimen name="pong_paddle_height">220dp</dimen>
</resources>
