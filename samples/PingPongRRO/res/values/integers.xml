<resources>
    <!-- Room for the XML's reactions to a win (the ball swells 400 ms, waits 600, shrinks 400;
         the loser leaves 400, waits 800, returns 400) before the next serve. A shorter pause
         is safe, since the pod serves only once the ball can be served from where it is, but
         the serve would then wait for the reactions anyway. -->
    <integer name="pong_serve_delay_ms">2200</integer>
</resources>
