<!-- The court: the whole display, under everything else. Its view draws the field and takes
     the touches that steer a paddle from the empty half. -->
<DecorPanel id="pong_court" defaultVariant="@id/open" displayId="0" controller="@xml/pong_court_controller">
    <Variant id="@+id/base">
        <Layer layer="1"/>
    </Variant>
    <Variant id="@+id/open" parent="@id/base">
        <Visibility isVisible="true"/>
        <Bounds left="0px" top="0px" right="100%" bottom="100%"/>
    </Variant>
</DecorPanel>
