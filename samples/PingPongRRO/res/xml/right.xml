<!-- The right navigation bar as the DEWD reference layout defines it (CarSystemUI samples);
     kept so the emulator stays navigable while the court is up. -->
<SystemBar id="Right" defaultVariant="@id/open" displayId="0" type="navigation" barZOrder="0" hideForKeyboard="true">
    <Variant id="@+id/base">
        <Layer layer="5"/>
        <Bounds top="0px" right="100%" width="116px" height="100%"/>
    </Variant>
    <Variant id="@+id/open" parent="@id/base">
        <Visibility isVisible="true"/>
    </Variant>
</SystemBar>
