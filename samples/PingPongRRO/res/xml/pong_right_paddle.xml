<!-- Jev's paddle (string/pong_jev_paddle names it). Same reaction as the left one, mirrored:
     it leaves on the left's win and comes back after the animation. -->
<DecorPanel id="pong_right_paddle" defaultVariant="@id/open" displayId="0"
            controller="@xml/pong_right_paddle_controller">
    <Variant id="@+id/base">
        <Layer layer="3"/>
    </Variant>
    <Variant id="@+id/open" parent="@id/base">
        <Visibility isVisible="true"/>
        <Bounds right="94.76%" top="40%" width="@dimen/pong_paddle_width" height="@dimen/pong_paddle_height"/>
    </Variant>
    <Variant id="@+id/gone" parent="@id/open">
        <Bounds right="108%" top="40%" width="@dimen/pong_paddle_width" height="@dimen/pong_paddle_height"/>
    </Variant>
    <Transitions>
        <Transition fromVariant="@id/open" toVariant="@id/gone" onEvent="_Pong_Win_left" duration="400"/>
        <Transition fromVariant="@id/gone" toVariant="@id/open" onEvent="_System_OnAnimationEndEvent"
                    onEventTokens="panelId=pong_right_paddle;panelToVariantId=gone" delay="800" duration="400"/>
    </Transitions>
</DecorPanel>
